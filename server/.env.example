# Copy to .env and adjust. All values are optional.

# Host interface the relay port is published on.
# Use 127.0.0.1 when nginx/Caddy terminates TLS in front of the relay.
BIND_ADDR=0.0.0.0

# Host port published by docker compose.
PORT=8080

# Viewers allowed per room by default (1-32).
MAX_VIEWERS=8

# A host is considered offline after this many milliseconds without frames.
HOST_TIMEOUT_MS=3000

# Sockets that never send `hello` are dropped after this.
HELLO_TIMEOUT_MS=5000

# Empty rooms are deleted after this idle time.
ROOM_IDLE_MS=600000

# Largest accepted snapshot.
MAX_FRAME_BYTES=65536
